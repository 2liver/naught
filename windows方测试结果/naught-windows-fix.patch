     // Vulkan/lavapipe 可能崩在 Qt 内部，探测期无法防御——跳过即可）
     const QSet<QString> skipSet = [] {
@@ -323,24 +443,37 @@ void CrtView::ensureRhi()
                                       .split(QLatin1Char(','), Qt::SkipEmptyParts);
